# SkillBridge AI environment variables
# Copy this file to .env.local and fill in real values when wiring up integrations.

# --- OpenAI (the AI Learning Gap Analyzer + Practice Plan Generator are mocked until this is set) ---
OPENAI_API_KEY=

# --- Supabase (the app uses local mock data until these are set) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
